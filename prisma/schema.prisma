generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/**
 * --------------------------------------------------------
 * ENUMS
 * --------------------------------------------------------
 */

enum Role {
  PATIENT
  ADMIN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  CASH
  ONLINE
  CARD
}

enum UnitType {
  TABLET
  BOX
}

model User {
  id       Int      @id @default(autoincrement())
  email    String
  fullName String
  phone    String   @db.VarChar(16)
  isActive Boolean  @default(true)
  dob      DateTime
  gender   Boolean?

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  role           Role
  orders         Order[]
  accounts       Account?
  cartItems      CartItem[]
  patientProfile PatientProfile?
  address        Address[]
}

/**
 * --------------------------------------------------------
 * PRODUCTS
 * --------------------------------------------------------
 */

model Brand {
  id          Int     @id @default(autoincrement())
  name        String
  slug        String  @unique
  description String?
  logoUrl     String?
  isActive    Boolean @default(true)

  products Product[]
}

model Category {
  id       Int        @id @default(autoincrement())
  name     String
  slug     String     @unique
  parentId Int?
  isActive Boolean    @default(true)
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[] @relation("CategoryHierarchy")

  products ProductCategory[]

  @@unique([parentId, slug])
}

model Product {
  id         Int      @id @default(autoincrement())
  name       String
  slug       String   @unique
  brandId    Int?
  stock      Int      @default(0)
  requiresRx Boolean  @default(false)
  isActive   Boolean  @default(true)
  shortDesc  String?  @db.Text
  image      String[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  brand Brand? @relation(fields: [brandId], references: [id], onDelete: SetNull)

  categories ProductCategory[]
  detail     ProductDetail?
  cartItems  CartItem[]
  unit       ProductUnit[]
  productAIs ProductAI[]
  orderItems OrderItem[]
}

model ProductDetail {
  productId Int @id

  description      String? @db.Text
  ingredients      String? @db.Text
  usage            String? @db.Text
  storageCondition String? @db.Text
  warnings         String? @db.Text
  seoTitle         String?
  seoDescription   String?

  registrationNumber String?
  manufacturer       String?
  origin             String? @default("USA")
  dosageForm         String?
  packaging          String?

  activeIngredients String? @db.Text
  composition       Json?

  indications        String? @db.Text
  contraindications  String? @db.Text
  sideEffects        String? @db.Text
  interactions       String? @db.Text
  overdose           String? @db.Text
  pharmacology       String? @db.Text
  pregnancyLactation String? @db.Text

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductCategory {
  productId  Int
  categoryId Int

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
}

model ProductUnit {
  id               Int      @id @default(autoincrement())
  productId        Int
  unitType         UnitType
  price            Decimal  @db.Decimal(12, 2)
  conversionFactor Decimal  @db.Decimal(10, 4)
  isDefault        Boolean  @default(false)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, unitType])
}

/**
 * --------------------------------------------------------
 * CART & ORDER WORKFLOW
 * --------------------------------------------------------
 */

model CartItem {
  id        Int      @id @default(autoincrement())
  userId    Int
  productId Int
  unitType  UnitType
  quantity  Decimal  @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId, unitType])
}

model Order {
  id              Int           @id @default(autoincrement())
  userId          Int?
  userEmail       String?       // snap — null for walk-in guests
  guestName       String?       // walk-in customer name (no account)
  guestPhone      String?       // walk-in customer phone (no account)
  shippingAddress Json
  status          OrderStatus   @default(PENDING)
  paymentMethod   PaymentMethod
  totalAmount     Decimal       @db.Decimal(14, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items OrderItem[]
  user  User?       @relation(fields: [userId], references: [id], onDelete: NoAction)

  @@index([createdAt])
  @@index([userId, createdAt])
}

model OrderItem {
  id             Int      @id @default(autoincrement())
  orderId        Int
  productId      Int
  productName    String
  unitType       UnitType
  quantity       Decimal  @db.Decimal(12, 2)
  baseQty        Decimal  @db.Decimal(12, 2)
  unitPrice      Decimal  @db.Decimal(12, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
}

model Account {
  id       Int    @id @default(autoincrement())
  userId   Int    @unique
  user     User   @relation(fields: [userId], references: [id])
  password String
}

model Address {
  id     Int  @id @default(autoincrement())
  userId Int
  user   User @relation(fields: [userId], references: [id])

  province String
  district String
  ward     String
  detail   String

  isDefault Boolean @default(false)
}

model PatientProfile {
  id              Int     @id @default(autoincrement())
  userId          Int     @unique
  user            User    @relation(fields: [userId], references: [id])
  context         String  @db.Text
  allergies       String? @db.Text
  chronicDiseases String? @db.Text
}

model ProductAI {
  id        Int     @id @default(autoincrement())
  productId Int
  product   Product @relation(fields: [productId], references: [id])
  context   String
}
